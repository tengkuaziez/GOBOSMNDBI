var SCALE = 10;

var aoi = ee.FeatureCollection(AOI_ASSET).geometry();

// =====================================================================
// TITIK REFERENSI
// class: 1 = bangunan
// class: 0 = bukan bangunan
// =====================================================================

function setClass(asset, cls, src) {
  return ee.FeatureCollection(asset).map(function (f) {
    return ee.Feature(f.geometry()).set({
      'class': cls,
      'src': src
    });
  });
}

var ptsB  = setClass(
  TITIK_BANGUNAN_ASSET,
  1,
  'asset_bangunan'
);

var ptsNB = setClass(
  TITIK_NONBANGUNAN_ASSET,
  0,
  'asset_nonbangunan'
);

var pts = ptsB.merge(ptsNB);

print('Asset bangunan dipakai:', TITIK_BANGUNAN_ASSET, ptsB.size());
print('Asset non-bangunan dipakai:', TITIK_NONBANGUNAN_ASSET, ptsNB.size());
print(
  'Jumlah titik per kelas (class: jumlah)',
  pts.aggregate_histogram('class')
);

// ---------- PETA TITIK REFERENSI ----------
Map.addLayer(
  ptsNB,
  {color: '00ff00'},
  'Referensi NON-bangunan (asset NB)',
  false
);

Map.addLayer(
  ptsB,
  {color: 'ffff00'},
  'Referensi BANGUNAN (asset bangunan)',
  false
);

// =====================================================================
// PREDIKSI 1: GOOGLE OPEN BUILDINGS
// =====================================================================

var ob = ee.FeatureCollection(
  'GOOGLE/Research/open-buildings/v3/polygons'

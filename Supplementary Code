// =====================================================================
// CONFUSION MATRIX + METRIK
// =====================================================================

function count(fc, cls, pred) {

  return ee.Number(
    fc.filter(
      ee.Filter.and(
        ee.Filter.eq('class', cls),
        ee.Filter.eq('pred', pred)
      )
    ).size()
  );

}

function evaluate(name, fc) {

  var tp = count(fc, 1, 1);
  var fn = count(fc, 1, 0);
  var fp = count(fc, 0, 1);
  var tn = count(fc, 0, 0);

  var n = tp
    .add(fn)
    .add(fp)
    .add(tn);

  var prec = tp.divide(
    tp.add(fp)
  );

  var rec = tp.divide(
    tp.add(fn)
  );

  return ee.Dictionary({

    method: name,

    TP: tp,
    FN: fn,
    FP: fp,
    TN: tn,
    N: n,

    OA_pct:
      tp.add(tn)
        .divide(n)
        .multiply(100),

    Precision_UA_pct:
      prec.multiply(100),

    Recall_PA_pct:
      rec.multiply(100),

    F1_pct:
      prec
        .multiply(rec)
        .multiply(2)
        .divide(prec.add(rec))
        .multiply(100),

    IoU_pct:
      tp
        .divide(
          tp.add(fp).add(fn)
        )
        .multiply(100)

  });

}

var results = ee.List([

  evaluate(
    'Google Open Buildings',
    predOB
  ),

  evaluate(
    'OSM Buildings',
    predOSM
  ),

  evaluate(
    'NDBI',
    predNDBI
  )

]);


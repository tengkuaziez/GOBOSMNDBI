// ===== SECTION 2: JUMLAH, DUPLIKAT, KEPADATAN, SENSITIVITAS THRESHOLD =====
var obAll = ee.FeatureCollection('GOOGLE/Research/open-buildings/v3/polygons')
  .filterBounds(aoi);

print('GOB jumlah poligon:', obAll.size());
print('GOB jumlah full_plus_code unik:', obAll.aggregate_count_distinct('full_plus_code'));
print('GOB poligon luas nol:', obAll.filter(ee.Filter.lte('area_in_meters', 0)).size());
print('GOB confidence min/max:', obAll.aggregate_min('confidence'), obAll.aggregate_max('confidence'));
print('GOB rata-rata luas (m2):', obAll.aggregate_mean('area_in_meters'));
print('GOB jumlah luas poligon (ha):',
  ee.Number(obAll.aggregate_sum('area_in_meters')).divide(10000));
print('GOB kepadatan (unit/km2):', obAll.size().divide(luasAOI_km2));

print('OSM jumlah poligon:', osm.size());
print('OSM kepadatan (unit/km2):', osm.size().divide(luasAOI_km2));

var thresholds = [0.65, 0.70, 0.75, 0.80, 0.85, 0.90];
var sens = ee.FeatureCollection(thresholds.map(function (t) {
  var f = obAll.filter(ee.Filter.gte('confidence', t));
  var predT = pts.map(function (p) {
    return p.set('pred', f.filterBounds(p.geometry()).size().gt(0));
  });
  var ev = evaluate('GOB>=' + t, predT);
  return ee.Feature(null, {
    threshold: t,
    n_buildings: f.size(),
    area_ha: f.geometry().area(1).divide(10000),
    TP: ev.get('TP'), FN: ev.get('FN'),
    FP: ev.get('FP'), TN: ev.get('TN')
  });
}));
print('Sensitivitas threshold:', sens);

Export.table.toDrive({
  collection: sens,
  description: 'Tabel_S1_Sensitivitas_Threshold',
  folder: 'GEE_Output',
  fileFormat: 'CSV'
});


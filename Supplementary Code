// LUAS DATASET
// =====================================================================

// ---------- LUAS AOI ----------
var luasAOI_m2 = aoi.area(1);
var luasAOI_ha = luasAOI_m2.divide(10000);
var luasAOI_km2 = luasAOI_m2.divide(1000000);

// ---------- LUAS GOOGLE OPEN BUILDINGS ----------
var luasOB_m2 = ob.geometry().area(1);
var luasOB_ha = luasOB_m2.divide(10000);
var luasOB_km2 = luasOB_m2.divide(1000000);

// ---------- LUAS OSM ----------
var luasOSM_m2 = osm.geometry().area(1);
var luasOSM_ha = luasOSM_m2.divide(10000);
var luasOSM_km2 = luasOSM_m2.divide(1000000);

print('=================================================');
print('LUAS DATASET');
print('=================================================');

print('Luas AOI Kota Binjai (m²):', luasAOI_m2);
print('Luas AOI Kota Binjai (ha):', luasAOI_ha);
print('Luas AOI Kota Binjai (km²):', luasAOI_km2);

print('Google Open Buildings (m²):', luasOB_m2);
print('Google Open Buildings (ha):', luasOB_ha);
print('Google Open Buildings (km²):', luasOB_km2);

print('OSM Buildings (m²):', luasOSM_m2);
print('OSM Buildings (ha):', luasOSM_ha);
print('OSM Buildings (km²):', luasOSM_km2);

// =====================================================================
// PREDIKSI 3: NDBI
// =====================================================================

var s2 = ee.ImageCollection(
  'COPERNICUS/S2_SR_HARMONIZED'
)
.filterBounds(aoi)
.filterDate(S2_START, S2_END)
.filter(
  ee.Filter.lt(
    'CLOUDY_PIXEL_PERCENTAGE',
    CLOUD_MAX
  )
)
.map(function (img) {

  var scl = img.select('SCL');

  return img.updateMask(
    scl.neq(3)
      .and(scl.neq(8))
      .and(scl.neq(9))
      .and(scl.neq(10))
      .and(scl.neq(11))
  );

});

print('Jumlah scene Sentinel-2:', s2.size());

var composite = s2
  .median()
  .clip(aoi);

var ndbiImg = composite
  .normalizedDifference(['B11', 'B8'])
  .rename('ndbi');

var built = ndbiImg
  .gt(NDBI_THR)
  .rename('built')
  .unmask(0);

// =====================================================================
// LUAS NDBI
// =====================================================================

var luasNDBI_m2 = built
  .selfMask()
  .multiply(ee.Image.pixelArea())
  .reduceRegion({
    reducer: ee.Reducer.sum(),
    geometry: aoi,
    scale: SCALE,
    maxPixels: 1e13
  })
  .get('built');

luasNDBI_m2 = ee.Number(luasNDBI_m2);

var luasNDBI_ha = luasNDBI_m2
  .divide(10000);

var luasNDBI_km2 = luasNDBI_m2
  .divide(1000000);

print('NDBI Built-up (m²):', luasNDBI_m2);
print('NDBI Built-up (ha):', luasNDBI_ha);
print('NDBI Built-up (km²):', luasNDBI_km2);

// ---------- PREDIKSI NDBI PADA TITIK ----------
var predNDBI = built
  .addBands(ndbiImg)
  .reduceRegions({
    collection: pts,
    reducer: ee.Reducer.first(),
    scale: SCALE
  })
  .map(function (f) {
    return f.set(
      'pred',
      f.get('built')
    );
  });

// =====================================================================
// PERSENTASE LUAS TERHADAP AOI
// =====================================================================

var persenOB = luasOB_m2
  .divide(luasAOI_m2)
  .multiply(100);

var persenOSM = luasOSM_m2
  .divide(luasAOI_m2)
  .multiply(100);

var persenNDBI = luasNDBI_m2
  .divide(luasAOI_m2)
  .multiply(100);

print('Persentase Google Open Buildings terhadap AOI (%):', persenOB);
print('Persentase OSM terhadap AOI (%):', persenOSM);
print('Persentase NDBI terhadap AOI (%):', persenNDBI);


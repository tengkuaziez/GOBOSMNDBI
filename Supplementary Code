// ---------- ASSET ----------
var AOI_ASSET = 'projects/basic-tube-416000/assets/Kota_Binjai';
var TITIK_BANGUNAN_ASSET    = 'projects/basic-tube-416000/assets/Titik_Uji_Akurasi';
var TITIK_NONBANGUNAN_ASSET = 'projects/basic-tube-416000/assets/Titik_Uji_Akurasi_NB2';
var OSM_ASSET               = 'projects/basic-tube-416000/assets/BangunanOSM';

// ---------- PARAMETER ----------
var S2_START = '2023-05-01';

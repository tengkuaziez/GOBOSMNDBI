// FP = titik non-bangunan terdeteksi sebagai bangunan
// FN = titik bangunan tidak terdeteksi

function errorPoints(name, fc) {

  function tag(f, err) {

    var c = f.geometry().coordinates();

    return f.set({

      dataset: name,

      error: err,

      lon: c.get(0),

      lat: c.get(1)

    });

  }

  var fp = fc
    .filter(
      ee.Filter.and(
        ee.Filter.eq('class', 0),
        ee.Filter.eq('pred', 1)
      )
    )
    .map(function (f) {

      return tag(
        f,
        'FP'
      );

    });

  var fn = fc
    .filter(
      ee.Filter.and(
        ee.Filter.eq('class', 1),
        ee.Filter.eq('pred', 0)
      )
    )
    .map(function (f) {

      return tag(
        f,
        'FN'
      );

    });

  return fp.merge(fn);

}


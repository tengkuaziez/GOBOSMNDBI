});

// =====================================================================
// PREDIKSI 2: OSM
// =====================================================================

var osm = ee.FeatureCollection(OSM_ASSET)
  .filterBounds(aoi);

var predOSM = pts.map(function (p) {
  return p.set(
    'pred',
    osm.filterBounds(p.geometry()).size().gt(0)

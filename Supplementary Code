});

var proj = ee.Projection('EPSG:32647');
var grid = aoi.coveringGrid(proj, 1000);
var cent = obAll.map(function (f) {
  return ee.Feature(f.geometry().centroid(1));
});
var gridN = grid.map(function (c) {
  var inside = c.geometry().intersection(aoi, 1);
  return c.set({
    n_buildings: cent.filterBounds(c.geometry()).size(),
    area_km2: inside.area(1).divide(1e6)
  });
});
Export.table.toDrive({
  collection: gridN,
  description: 'Grid1km_jumlah_bangunan_GOB',
  folder: 'GEE_Output',
